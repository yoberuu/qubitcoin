# Shared btc-rpc-explorer settings for all QubitCoin networks.
BTCEXP_COIN=QBTC
BTCEXP_HOST=0.0.0.0
BTCEXP_PORT=3002

# QubitCoin has no exchange-rate feeds yet
BTCEXP_NO_RATES=true
BTCEXP_PRIVACY_MODE=true

# Reduce heavy queries on small test nodes
BTCEXP_SLOW_DEVICE_MODE=true

# Disable external address APIs (no electrum for QubitCoin yet)
# Address pages use qbitcoind validateaddress + optional txindex scan

# Optional: uncomment to password-protect the explorer UI
# BTCEXP_BASIC_AUTH_PASSWORD=changeme

# RPC timeout (ms) — PQ blocks can be large
BTCEXP_BITCOIND_RPC_TIMEOUT=30000
