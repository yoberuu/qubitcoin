# Optional overrides — copy to .env in this directory.
# docker compose automatically loads .env from the project directory.

# Host ports (one per profile if running multiple explorers)
# REGTEST_EXPLORER_PORT=3002
# TESTNET3_EXPLORER_PORT=3003
# TESTNET4_EXPLORER_PORT=3004
# MAINNET_EXPLORER_PORT=3005

# Cookie directories (must contain .cookie from qbitcoind)
# REGTEST_COOKIE_DIR=/home/you/.qubitcoin/regtest
# TESTNET3_COOKIE_DIR=/home/you/.qubitcoin/testnet3
# TESTNET4_COOKIE_DIR=/home/you/.qubitcoin/testnet4
# MAINNET_COOKIE_DIR=/home/you/.qubitcoin

# If qbitcoind runs in another Docker container on the same compose network,
# set BTCEXP_BITCOIND_HOST in env/<network>.env to the service name instead
# of host.docker.internal.
